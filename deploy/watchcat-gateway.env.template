# Copy to /etc/watchcat-gateway.env on the Raspberry Pi and set every value.
PORT=3102
WATCHCAT_UPLOAD_DIR=/home/ray/uploads/watchcat
HAILO_CAMERA_URL=http://127.0.0.1:3001
WATCHCAT_TOKEN=<SET_A_SHARED_RANDOM_TOKEN>
HAILO_CAMERA_TOKEN=<SET_HAILO_CAMERA_AUTH_TOKEN>

# No camera address belongs here. The gateway never dials the sensor; 캣센서 polls
# GET /api/v1/commands/next and uploads to POST /api/v1/frames on its own.

# Optional tuning. Defaults shown.
# WATCHCAT_MAX_FRAME_BYTES=2097152
# WATCHCAT_COMMAND_LEASE_MS=30000
# WATCHCAT_COMMAND_MAX_ATTEMPTS=3
